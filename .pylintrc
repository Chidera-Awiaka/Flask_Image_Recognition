[MAIN]
# Match the Python version used locally and in CI.
py-version=3.10
# Skip non-Python and environment folders.
ignore=venv,.venv,test_images,static,templates
# TensorFlow/Keras are C extensions; let Pylint inspect their members.
extension-pkg-allow-list=tensorflow

[FORMAT]
# Slightly longer than PEP 8's 79 to fit descriptive test names.
max-line-length=100

[MESSAGES CONTROL]
# No checks are globally disabled: every warning is fixed in the code.
disable=

[DESIGN]
max-args=5
